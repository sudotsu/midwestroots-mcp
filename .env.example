NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Comma-separated exact Host header values. Required in production.
MCP_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Comma-separated URL origins. Required in production; origin-less server clients remain valid.
MCP_ALLOWED_ORIGINS=https://chatgpt.com

MAX_REQUEST_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
