NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Comma-separated exact Host header values. Required in production.
# On Vercel, generated deployment/branch/production hostnames are added automatically;
# list custom domains or other additional exact hosts here.
MCP_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Comma-separated exact URL origins. Required in production; origin-less server clients remain valid.
# Keep this narrow; do not use a wildcard to make a host integration pass.
MCP_ALLOWED_ORIGINS=https://chatgpt.com

MAX_REQUEST_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
