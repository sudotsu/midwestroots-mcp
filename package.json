{
  "name": "midwestroots-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:ui": "node scripts/build-species-ui.mjs",
    "build": "npm run build:ui && tsc -p tsconfig.build.json",
    "predev": "npm run build:ui",
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/src/server/main.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:ui",
    "test": "vitest run",
    "test:canonical-species": "vitest run tools/species-guide/vendor/omahatreecare/src/data",
    "test:foundation": "vitest run tests/case tests/safety tests/species tests/server",
    "vendor:species": "node scripts/vendor-species.mjs",
    "verify:vendor": "node scripts/verify-species-vendor.mjs",
    "check": "npm run typecheck && npm run verify:vendor && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
